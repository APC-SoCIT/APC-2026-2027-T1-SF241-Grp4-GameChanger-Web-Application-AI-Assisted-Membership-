title <b><size:15><color:#FFFFFF>C4 MODEL — LEVEL 4 (CODE DIAGRAM)</color></size></b>\n<b><size:19><color:#FFFFFF>HR GameChanger: Manage Payment Use Case</color></size></b>\n<back:#3B3F8C><color:#FFFFFF>  Next.js 15 API Routes  </color></back>  <back:#1E6E62><color:#FFFFFF>  Supabase / PostgreSQL  </color></back>  <back:#8A5A1E><color:#FFFFFF>  HitPay Gateway  </color></back>\n

package "PACKAGE 1: PRESENTATION & REST API CONTROLLERS  (Next.js API Routes)" #1E1830;line:9D7BF0 {

  class "PaymentController" as PAY_CTRL <<REST Controller>> #6C4FD1;line:B49CFA;text:FFFFFF {
    + getSessionFee(sessionId: UUID): FeeDTO
    + initiateCheckout(sessionId, memberId: UUID): CheckoutDTO
  }

  class "PaymentAdminController" as PAY_ADMIN_CTRL <<REST Controller>> #6C4FD1;line:B49CFA;text:FFFFFF {
    + listTransactions(filters: TxnFilters): TransactionSummaryDTO[]
    + getTransactionById(txnId: UUID): TransactionDTO
  }

  class "HitPayWebhookController" as HOOK_CTRL <<REST Controller>> #6C4FD1;line:B49CFA;text:FFFFFF {
    + receiveWebhook(payload: HitPayWebhookPayload): void
  }
}

package "PACKAGE 2: APPLICATION SUPPORT SERVICES  (Middleware / Cross-Cutting)" #103331;line:2FD9C4 {

  class "WebhookSignatureValidator" as SIG_VALID <<Validator>> #17958A;line:2FD9C4;text:FFFFFF {
    + verifyHmacSignature(payload, secret: string): boolean
  }

  class "BillingPrivilegeGuard" as BILL_GUARD <<Middleware>> #17958A;line:2FD9C4;text:FFFFFF {
    + requireBillingAccess(session: AuthSession): void
  }

  class "PaymentNotificationService" as PAY_NOTIFY <<Service>> #17958A;line:2FD9C4;text:FFFFFF {
    + sendConfirmationEmail(txnId: UUID): void
    + sendFailureAlert(txnId: UUID): void
  }
}

package "PACKAGE 3: DOMAIN SERVICE LAYER  (Business Logic)" #0F2B18;line:3FCB6B {

  class "PaymentService" as PAY_SVC <<Service>> #1C8A46;line:3FCB6B;text:FFFFFF {
    + createOrder(sessionId, memberId: UUID): Transaction
    + markPaid(txnId: UUID, ref: string): void
    + markFailed(txnId: UUID, reason: string): void
  }

  class "TransactionQueryService" as TXN_QUERY_SVC <<Service>> #1C8A46;line:3FCB6B;text:FFFFFF {
    + search(filters: TxnFilters): Transaction[]
    + getById(txnId: UUID): Transaction
  }

  class "ReceiptService" as RECEIPT_SVC <<Service>> #1C8A46;line:3FCB6B;text:FFFFFF {
    + generateReceipt(txnId: UUID): ReceiptDTO
  }
}

package "PACKAGE 4: DOMAIN ENTITIES, VALUE OBJECTS & ENUMS  (Domain Model)" #331F0F;line:E8973B {

  class "Transaction" as TXN <<Aggregate Root>> #B5651D;line:E8973B;text:FFFFFF {
    - id: UUID
    - sessionId: UUID
    - memberId: UUID
    - amount: number
    - method: PaymentMethod
    - status: PaymentStatus
    - referenceNo: string
    - createdAt: Date
    --
    + markPaid(ref: string): void
    + markFailed(reason: string): void
  }

  class "Receipt" as RECEIPT <<Value Object>> #A65E22;line:E8973B;text:FFFFFF {
    - referenceNo: string
    - amount: number
    - issuedAt: Date
  }

  enum "PaymentStatus" as PAY_STATUS_ENUM <<Enum>> #8C5A2E;line:E8973B;text:FFFFFF {
    PENDING
    PAID
    FAILED
    CANCELLED
  }

  enum "PaymentMethod" as PAY_METHOD_ENUM <<Enum>> #8C5A2E;line:E8973B;text:FFFFFF {
    GCASH
    CARD
    MAYA
  }
}

package "PACKAGE 5: INFRASTRUCTURE, REPOSITORIES & EXTERNAL ADAPTERS  ()" #1B222B;line:6FA8C9 {

  interface "ITransactionRepository" as ITXN_REPO <<Interface>> #2E5F7A;line:6FA8C9;text:FFFFFF {
    + findById(id: UUID): Transaction
    + search(filters): Transaction[]
    + save(txn: Transaction): void
  }

  class "SupabaseTransactionRepository" as SUPA_TXN_REPO <<Repository>> #2E5F7A;line:6FA8C9;text:FFFFFF {
    + findById(id: UUID): Transaction
    + search(filters): Transaction[]
    + save(txn: Transaction): void
  }

  class "HitPayGatewayAdapter" as HITPAY_ADAPTER <<Adapter>> #2E5F7A;line:6FA8C9;text:FFFFFF {
    + createCheckoutSession(order: OrderRef): CheckoutUrl
    + parseWebhookPayload(raw): HitPayWebhookPayload
  }
}

