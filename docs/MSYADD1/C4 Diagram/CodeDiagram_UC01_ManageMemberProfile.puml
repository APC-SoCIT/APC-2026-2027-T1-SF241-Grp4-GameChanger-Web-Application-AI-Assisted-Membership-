    + archiveMember(memberId, actorId: UUID): void
  }

  class "ProfileAuditService" as AUDIT_SVC <<Service>> #1C8A46;line:3FCB6B;text:FFFFFF {
    + logChange(actorId, targetId, action, changes): void
  }
}

' ══════════════════════════════════════════════════════════
' PACKAGE 4 — DOMAIN ENTITIES, VALUE OBJECTS & ENUMS
' ══════════════════════════════════════════════════════════
package "PACKAGE 4: DOMAIN ENTITIES, VALUE OBJECTS & ENUMS  (Domain Model)" #331F0F;line:E8973B {

  class "Profile" as PROFILE <<Aggregate Root>> #B5651D;line:E8973B;text:FFFFFF {
    - id: UUID
    - fullName: string
    - email: string
    - phoneNumber: string
    - avatarUrl: string
    - role: UserRole
    - status: ProfileStatus
    - provinceId: number
    - companyId: number
    - departmentId: number
    - position: string
    --
    + updateContactInfo(info: ContactInfo): void
    + archive(): void
    + restore(): void
  }

  class "ContactInfo" as CONTACT <<Value Object>> #A65E22;line:E8973B;text:FFFFFF {
    - phoneNumber: string
    - email: string
  }

  class "ProfileAuditLog" as AUDITLOG <<Entity>> #A65E22;line:E8973B;text:FFFFFF {
    - id: number
    - actorId: UUID
    - targetProfileId: UUID
    - action: AuditAction
    - changes: JSON
    - createdAt: Date
  }

  enum "UserRole" as ROLE_ENUM <<Enum>> #8C5A2E;line:E8973B;text:FFFFFF {
    MEMBER
    HR_ADMIN
  }

  enum "ProfileStatus" as STATUS_ENUM <<Enum>> #8C5A2E;line:E8973B;text:FFFFFF {
    ACTIVE
    ARCHIVED
    DELETED
  }

  enum "AuditAction" as ACTION_ENUM <<Enum>> #8C5A2E;line:E8973B;text:FFFFFF {
    CREATED
    UPDATED
    ARCHIVED
    RESTORED
    DELETED
  }
}

' ══════════════════════════════════════════════════════════
' PACKAGE 5 — INFRASTRUCTURE, REPOSITORIES & EXTERNAL ADAPTERS
' ══════════════════════════════════════════════════════════
