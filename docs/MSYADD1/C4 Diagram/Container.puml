@startuml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam ArrowColor #555555
skinparam ArrowThickness 1.1
skinparam ArrowFontSize 9
skinparam ArrowFontColor #444444
skinparam shadowing false

title <b>Container Diagram — HR GameChanger</b>\n

' ── PEOPLE ──
actor "Member" as MEM #1168BD
actor "HR Admin" as HR #1168BD

' ── EXTERNAL ──
rectangle "**Zoom**\n<size:9>Session metadata</size>" as ZOOM #999999
rectangle "**HitPay**\n<size:9>Payment Gateway\nGCash / Credit Card</size>" as HP #999999
rectangle "**Gemini API**\n<size:9>AI Recommendation</size>" as GEM #999999
database "**Database**\n<size:9>Supabase PostgreSQL\nAll system records</size>" as DB #999999

package "HR GameChanger System" #F5F5F5 {

  rectangle "**Web Application**\n<size:9>[Next.js + Tailwind CSS]\nDelivers all pages for\nMember and HR Admin.\nHandles UI for all\n8 use cases.</size>" as WEB #1168BD

  rectangle "**Auth Module**\n<size:9>[NextAuth.js + Supabase]\nSecure login for Member\nand HR Admin. Enforces\nrole-based access control.</size>" as AUTH #1168BD

  rectangle "**Session Module**\n<size:9>[Next.js API Routes]\nReceives session data\nfrom Zoom. Manages\nsession records and\nschedule parameters.</size>" as SESS #1168BD

  rectangle "**Join Session Module**\n<size:9>[Next.js API Routes]\nChecks payment status\nbefore granting access.\nRedirects to payment\nif session fee is unpaid.\nConnects member to Zoom.</size>" as JOIN #1168BD

  rectangle "**Payment Module**\n<size:9>[Next.js + HitPay SDK]\nGenerates HitPay\ncheckout request.\nReceives and validates\npayment webhook.\nUpdates status to Paid.</size>" as PAY #1168BD

  rectangle "**Dashboard Module**\n<size:9>[Next.js + Chart.js]\nDisplays charts, attendance\nsummaries, and training\nstatistics for Member\nand HR Admin.</size>" as DASH #1168BD

  rectangle "**Profile Module**\n<size:9>[Next.js API Routes]\nHandles Manage Profile\nfor Member and HR Admin.\nHandles View Member\nfor HR Admin.</size>" as PROF #1168BD

  rectangle "**Report Module**\n<size:9>[Next.js API Routes]\nCompiles attendance and\nsession data into reports.\nSupports export and print.\nExtends View Dashboard.</size>" as REP #1168BD

  rectangle "**AI Module**\n<size:9>[Next.js + Gemini API]\nTriggered when member\njoins a session.\nQueries Gemini API for\npersonalized suggestions.\nRenders results on dashboard.</size>" as AI #1168BD

}

' ── USERS TO WEB ──
MEM --> WEB : "Join Session,\nProcess Payment,\nView Dashboard,\nManage Profile [HTTPS]"
HR --> WEB : "Manage Session,\nView Member,\nGenerate Report,\nJoin Session [HTTPS]"

' ── WEB TO MODULES ──
WEB --> AUTH : "Login and\naccess control"
WEB --> SESS : "Manage Session"
WEB --> JOIN : "Join Session"
WEB --> PAY : "Process Payment"
WEB --> DASH : "View Dashboard"
WEB --> PROF : "Manage Profile\nView Member"
WEB --> REP : "Generate Report"

' ── MODULE RELATIONSHIPS ──
JOIN --> PAY : "<<include>>\nRedirects to payment\nif fee is unpaid"
PAY --> JOIN : "Unlocks Join Session\nafter payment confirmed"
JOIN --> AI : "<<extend>>\nTriggers AI session\nsuggestions on join"
DASH --> AI : "<<include>>\nRenders AI suggestions\non dashboard"
REP --> DASH : "<<extend>>\nExtends dashboard\nwith report view"
SESS --> JOIN : "<<extend>>\nSession data feeds\nJoin Session flow"

' ── EXTERNAL CONNECTIONS ──
AUTH --> DB : "Validates credentials"
SESS --> ZOOM : "Fetches session\nmetadata"
SESS --> DB : "Saves session records"
JOIN --> DB : "Checks payment\nstatus and availability"
PAY --> HP : "Creates checkout;\nreceives webhook"
PAY --> DB : "Updates payment\nstatus to Paid"
DASH --> DB : "Retrieves analytics\nand training data"
PROF --> DB : "Reads and saves\nprofile records"
REP --> DB : "Retrieves attendance\nand session records"
AI --> GEM : "Sends context;\nreceives suggestions"
AI --> DB : "Queries session\nhistory"

@enduml
